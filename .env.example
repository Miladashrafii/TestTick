# Environment template for TestTick
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional: enables OpenAI-backed test case drafting.
# Without a key, drafting falls back to a deterministic local generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: repository or workspace root used to build "new issue" deep links,
# e.g. https://github.com/your-org/your-repo
GITHUB_ISSUES_BASE_URL=
